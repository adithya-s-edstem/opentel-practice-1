{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Single pane of glass for the todo app. Stats and graphs come from Prometheus (metrics); the bottom panel comes from Loki (logs); spans visible in the trace links come from Jaeger.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "Open Jaeger",
      "tooltip": "Jump to Jaeger UI for distributed traces",
      "type": "link",
      "url": "http://localhost:16686",
      "targetBlank": true,
      "icon": "external link"
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "HTTP request rate",
      "description": "Requests per second across all routes on todo-backend. Derived from the OTel Flask auto-instrumentation's http.server.duration histogram (we just take the count and rate() it).",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_duration_milliseconds_count{service_name=\"todo-backend\"}[1m]))",
          "legendFormat": "rps"
        }
      ]
    },
    {
      "id": 2,
      "title": "P95 latency",
      "description": "95th percentile of HTTP server duration across all routes. histogram_quantile over the bucketed rate is the canonical PromQL pattern for percentiles from OTel histograms.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 500 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_duration_milliseconds_bucket{service_name=\"todo-backend\"}[1m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 3,
      "title": "Todos created",
      "description": "Cumulative count of successful create operations. Sourced from our custom counter `todo.operations` (operation=create, status=ok), defined in backend/observability.py.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "purple", "value": null }] }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(todo_operations_total{operation=\"create\",status=\"ok\"})",
          "legendFormat": "created"
        }
      ]
    },
    {
      "id": 10,
      "title": "Todos completed",
      "description": "Cumulative count of todos transitioned from incomplete to complete. Sourced from our custom counter `todo.operations` (operation=complete, status=ok). The backend only increments this on the false→true transition — re-saves or un-completions don't count.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(todo_operations_total{operation=\"complete\",status=\"ok\"}) or vector(0)",
          "legendFormat": "completed"
        }
      ]
    },
    {
      "id": 11,
      "title": "Outstanding todos",
      "description": "Running gap between todos created and todos completed (created - completed). Both inputs come from our custom counter `todo.operations`. Goes up when work piles on, drops as items get checked off. Note: this is derived from event counters, not from the DB — it counts lifecycle events, so a delete of an incomplete todo will leave the delta higher than the actual row count.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(todo_operations_total{operation=\"create\",status=\"ok\"}) or vector(0)) - (sum(todo_operations_total{operation=\"complete\",status=\"ok\"}) or vector(0))",
          "legendFormat": "outstanding"
        }
      ]
    },
    {
      "id": 4,
      "title": "Failed operations",
      "description": "Cumulative count of todo operations that errored. Custom counter, status=error label.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(todo_operations_total{status=\"error\"}) or vector(0)",
          "legendFormat": "errors"
        }
      ]
    },
    {
      "id": 5,
      "title": "Request rate by route",
      "description": "Per-endpoint request rate. The `http_route` label comes from the OTel Flask instrumentation (e.g. /api/todos/<int:todo_id>).",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10, "lineInterpolation": "smooth" } }
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_route, http_method) (rate(http_server_duration_milliseconds_count{service_name=\"todo-backend\"}[1m]))",
          "legendFormat": "{{http_method}} {{http_route}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "P95 latency by route",
      "description": "Per-endpoint p95. Spot the slow endpoint at a glance.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "fillOpacity": 5, "lineInterpolation": "smooth" } }
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, http_route) (rate(http_server_duration_milliseconds_bucket{service_name=\"todo-backend\"}[1m])))",
          "legendFormat": "p95 {{http_route}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Todo operations by type",
      "description": "Business-level metric: rate of create / read / list / update / delete. Useful for spotting usage shifts that don't show up at the HTTP layer (e.g. a sudden spike of deletes).",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "fillOpacity": 15, "stacking": { "mode": "normal" } } }
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation) (rate(todo_operations_total{status=\"ok\"}[1m]))",
          "legendFormat": "{{operation}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Title length distribution (p50/p95)",
      "description": "Histogram of created todo title lengths. Demonstrates that any value you care about can be a metric — here it's a silly business measurement, but the same shape works for cache sizes, payload bytes, queue depths, etc.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 5 } }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(todo_title_length_characters_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(todo_title_length_characters_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 12,
      "title": "Created vs completed (and outstanding delta)",
      "description": "Cumulative created and completed counts plotted alongside their delta (the outstanding backlog). When the green/purple lines diverge, work is piling up; when they converge, the team is catching up. Same caveat as the stat panel: the delta is derived from event counters, not the DB row count.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 10, "lineInterpolation": "smooth" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "outstanding" },
            "properties": [
              { "id": "custom.fillOpacity", "value": 25 },
              { "id": "custom.lineWidth", "value": 2 },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "created" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "purple" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "completed" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }
            ]
          }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(todo_operations_total{operation=\"create\",status=\"ok\"}) or vector(0)",
          "legendFormat": "created"
        },
        {
          "refId": "B",
          "expr": "sum(todo_operations_total{operation=\"complete\",status=\"ok\"}) or vector(0)",
          "legendFormat": "completed"
        },
        {
          "refId": "C",
          "expr": "(sum(todo_operations_total{operation=\"create\",status=\"ok\"}) or vector(0)) - (sum(todo_operations_total{operation=\"complete\",status=\"ok\"}) or vector(0))",
          "legendFormat": "outstanding"
        }
      ]
    },
    {
      "id": 9,
      "title": "Backend logs (Loki)",
      "description": "Live tail of structured logs from the backend. Look for `trace_id=...` in a line — it'll be clickable (derived field) and jump you to the matching trace in Jaeger.",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 28 },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"todo-backend\"}",
          "queryType": "range"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["todo", "tutorial", "otel"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Todo App — Overview",
  "uid": "todo-overview",
  "version": 1,
  "weekStart": ""
}
